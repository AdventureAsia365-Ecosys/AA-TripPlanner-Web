# Frontend environment — copy to frontend/.env.local and fill in.
# Never commit .env.local.

# Mapbox PUBLIC token (pk...). URL-restricted in production.
# This is exposed to the browser by design (GL JS runs client-side).
NEXT_PUBLIC_MAPBOX_TOKEN=

# Backend Lambda URLs (server-side only — used by BFF routes, never
# exposed to the browser). Point at local backend during dev.
BROWSE_API_URL=http://localhost:8001
TRIP_API_URL=http://localhost:8002

# AA-908 traveller sign-in (server-side only). Leave empty to plan as a guest only.
# TP_SESSION_SECRET: at least 32 random characters (seals the session cookies).
# TP_COGNITO_BFF_KEY: the value of AA-CIS-Infra secret tripplanner/<env>/cognito-bff-key (WAF re-keying).
TP_SESSION_SECRET=
TP_COGNITO_BFF_KEY=
