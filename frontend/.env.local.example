# Frontend environment — copy to frontend/.env.local and fill in.
# Never commit .env.local.

# Mapbox PUBLIC token (pk...). URL-restricted in production.
# This is exposed to the browser by design (GL JS runs client-side).
NEXT_PUBLIC_MAPBOX_TOKEN=

# Backend Lambda URLs (server-side only — used by BFF routes, never
# exposed to the browser). Point at local backend during dev.
BROWSE_API_URL=http://localhost:8001
TRIP_API_URL=http://localhost:8002

# AA-1092: the tenant assertion key (server-side only), the "current" value of AA-CIS-Infra secret
# tripplanner/<env>/tenant-assertion-key; at least 32 characters. Set the same value as TP_TENANT_ASSERTION_KEY on the
# local assembly/browse servers. Empty = the edge key signs (the cut-over fallback the Lambdas accept only in a window).
TP_TENANT_ASSERTION_KEY=
