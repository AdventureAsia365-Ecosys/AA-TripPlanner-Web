{
  "_about": "AA-1041 slice 2: the planning chat test set (backend/tests/test_aa1041_plan_chat_cases.py). Invented catalog (countries Norland and Tavora, places and experiences in the test module), invented phrasing; the model is mocked: `model` is the scripted output of each model call in order (an object is sent as its JSON, a string as is, {\"raise\": ...} raises a provider error). `state` sets the money gates and limits. `expect` is the behaviour the server must show whatever the model wrote. Categories: on_catalog, off_catalog, injection, budget.",
  "cases": [
    {
      "id": "plan_three_days_in_a_sold_country", "category": "on_catalog",
      "message": "Plan 3 days in Norland for me",
      "model": [
        {"tool": "route_options", "args": {"country": "Norland", "days": 3}},
        {"reply": "Here is a 3-day route on the Norland Coast and Hills tour: Lantern Market Walk in Port Selby, Mistral Bay Kayaking and the Ember Hills Tea Trail.", "kind": "answer", "proposal": {"action": "replace", "refs": ["c1", "c2", "c3"]}}
      ],
      "expect": {"status": "ok", "outcome": "answer", "from_model": true, "action": "replace",
                 "final": ["Lantern Market Walk", "Mistral Bay Kayaking", "Ember Hills Tea Trail"], "tools": ["route_options"]}
    },
