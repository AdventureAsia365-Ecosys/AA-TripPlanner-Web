# Backend environment — copy to backend/.env and fill in. Never commit .env.

# --- Database (shared RDS, acc2, us-west-1) via SSH/SSM tunnel locally ---
TRIPPLANNER_DATABASE_URL=postgresql://user:password@localhost:5432/aa_db

# --- Mapbox (server-side geocoding token; NOT a NEXT_PUBLIC_ var) ---
MAPBOX_GEOCODING_TOKEN=

# --- Bedrock ---
# LLM (compose/renarrate): satellite assume-role — acc3 primary, acc1
# fallback (acc2 is a channel account, can't invoke Claude).
BEDROCK_REGION=us-west-1
BEDROCK_ACCT_PRIMARY=786888028788
BEDROCK_ACCT_FALLBACK=867490540162
BEDROCK_ROLE_NAME=
BEDROCK_EXTERNAL_ID_PRIMARY=aa296-satellite-bedrock-acc3
BEDROCK_EXTERNAL_ID_FALLBACK=aa296-satellite-bedrock
BEDROCK_MODEL_COMPOSE=us.anthropic.claude-sonnet-4-6
# Embedding: DIRECT acc2 call (no satellite) — Cohere Embed v4, 1536-dim.
BEDROCK_MODEL_EMBED=us.cohere.embed-v4:0

# --- Advisor notification (single config value) ---
ADVISOR_NOTIFY_EMAIL=pqnghiep1354@gmail.com

# --- Feature flags ---
REQUIRE_REGISTRATION_BEFORE_HANDOFF=true
